/********** QTabBar **********/
QTabBar::tab {
       height: 25px;
       color: rgb(180, 180, 180);
       background: transparent;font: 14px;margin-right: 10px;margin-left: 10px;
}
QTabBar::tab:hover {
       font: 15px;
       border-bottom: 2px solid rgb(150, 150, 150);
       color: white;height: 25px;margin-right: 10px;margin-left: 10px;
}
QTabBar::tab:selected {
       font: 15px;
       border-bottom: 2px solid rgb(70, 150, 90);
       color: white;height: 25px;margin-right: 10px;margin-left: 10px;
}
QTabWidget#tabWidget::pane {
       border: 1px solid rgb(80, 80, 80);
       background: rgb(43, 43, 43);
       margin-top: 12px;color: white;border-radius: 10px;
}
/********** QListView **********/
QListView::item {
       margin: 2px;
       font: 18px;
}
